{
  "version": "0.4.0",
  "enabled": true,
  "enforceWorkerForEdits": true,
  "defaultTier": "hydrogen-high",
  "quotaMonitoring": {
    "enabled": true,
    "dailyTokenBaseline": 5000000,
    "lowQuotaThresholdPercent": 10.0,
    "displayInSummary": true,
    "calibratedLimits": {
      "fiveHourRemainingPercent": 80.4,
      "weeklyRemainingPercent": 95.2
    },
    "thresholds": {
      "fiveHourLimitPercent": 10.0,
      "weeklyLimitPercent": 25.0
    },
    "alertSettings": {
      "thresholdPercent": 10.0,
      "fiveHourThresholdPercent": 10.0,
      "weeklyThresholdPercent": 25.0,
      "alertScope": "low_only",
      "showAgentBreakdown": false,
      "agents": {
        "antigravity_5h": {
          "threshold": 10.0
        },
        "antigravity_weekly": {
          "threshold": 25.0
        },
        "claude_3p": {
          "threshold": 20.0
        },
        "copilot": {
          "threshold": 1.0
        },
        "codex": {
          "threshold": 20.0
        }
      }
    }
  },
  "autonomousCollaboration": {
    "enabled": true,
    "autoCrossVerification": {
      "enabled": true,
      "target": "codex",
      "model": "gpt-6-luna",
      "triggerKeywords": [
        "architect",
        "concurrency",
        "security",
        "deadlock",
        "critical",
        "심층",
        "보안",
        "동시성",
        "교차 검증",
        "에지케이스"
      ]
    },
    "autoGitCopilot": {
      "enabled": true,
      "target": "copilot",
      "triggerKeywords": [
        "pr",
        "pull request",
        "commit",
        "git",
        "커밋",
        "풀리퀘스트"
      ]
    },
    "autoQuotaOffloading": {
      "enabled": true,
      "thresholdPercent": 10.0,
      "preferredFallback": "copilot"
    }
  },
  "adaptiveEffort": {
    "enabled": true,
    "defaultModel": "gemini-4-hydrogen-high",
    "rules": [
      {
        "name": "deep_architecture_concurrency",
        "targetModel": "gemini-4-carbon-high",
